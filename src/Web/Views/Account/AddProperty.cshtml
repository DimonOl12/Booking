@model Web.Models.AddPropertyViewModel
@{
    ViewData["Title"] = "Додати помешкання";
    Layout = null;
    var firstName   = User.FindFirst("FirstName")?.Value ?? "";
    var lastName    = User.FindFirst("LastName")?.Value ?? "";
    var initials    = User.FindFirst("Initials")?.Value ?? "?";
    var displayName = string.IsNullOrEmpty(firstName)
        ? (User.Identity?.Name ?? "")
        : $"{firstName} {lastName}".Trim();
    bool hasError = !string.IsNullOrEmpty(Model.SaveError);
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reservio — Додати помешкання</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&family=Unbounded:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/add-property.css" />
    <link rel="stylesheet" href="~/css/home.css" />
</head>
<body>
<div class="apw-page">

    <!-- Fallback background image -->
    <div class="apw-bg"><img src="~/images/bg_reg_acco.jpg" alt="" /></div>
    <!-- Dark overlay -->
    <div class="apw-overlay"></div>

    @await Html.PartialAsync("_HomeNavbar")

    <!-- ════════════════════════════════════════
         MAIN FORM
         ════════════════════════════════════════ -->
    <form method="post" asp-action="AddProperty" asp-controller="Account"
          enctype="multipart/form-data" id="apwForm">
        @Html.AntiForgeryToken()

        <div class="apw-content">

            <!-- ═══ STEP 0: Type ═══ -->
            <div class="apw-step apw-step-0-layout" id="step0">
                <h1 class="apw-step-title-hero">
                    Додайте своє житло на платформу Reservio та приймайте гостей
                </h1>
                <p class="apw-step-subtitle-hero">
                    Щоб розпочати, оберіть тип помешкання, яке ви хочете розмістити
                </p>
                <div class="apw-type-grid">
                    <div class="apw-type-card" onclick="pickType(this)">
                        <div class="apw-type-card-info">
                            <h3>Апартаменти</h3>
                            <p>Помешкання з меблями і кухнею, яке гості бронюють цілком</p>
                        </div>
                        <span class="apw-type-card-arrow">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </div>
                    <div class="apw-type-card" onclick="pickType(this)">
                        <div class="apw-type-card-info">
                            <h3>Будинки</h3>
                            <p>Апартаменти, вілли, будинки для відпочинку та інше</p>
                        </div>
                        <span class="apw-type-card-arrow">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </div>
                    <div class="apw-type-card" onclick="pickType(this)">
                        <div class="apw-type-card-info">
                            <h3>Готель</h3>
                            <p>Готелі, апартаменти з обслуговуванням, хостели, апарт-готелі</p>
                        </div>
                        <span class="apw-type-card-arrow">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </div>
                    <div class="apw-type-card" onclick="pickType(this)">
                        <div class="apw-type-card-info">
                            <h3>Альтернативні помешкання</h3>
                            <p>Кемпінги, глемпінги, наметові, бортові та інші унікальні варіанти</p>
                        </div>
                        <span class="apw-type-card-arrow">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 1: Count ═══ -->
            <div class="apw-step apw-step-layout" id="step1">
                <h2 class="apw-step-title">Скільки апартаментів ви реєструєте?</h2>
                <div class="apw-card">
                    <div class="apw-option-card selected" id="optOne" onclick="pickOption('optOne','optMany')">
                        <div class="apw-option-radio"><div class="apw-option-radio-dot"></div></div>
                        <span class="apw-option-icon">🏠</span>
                        <span class="apw-option-text">Одні апартаменти</span>
                    </div>
                    <div class="apw-option-card" id="optMany" onclick="pickOption('optMany','optOne')">
                        <div class="apw-option-radio"><div class="apw-option-radio-dot"></div></div>
                        <span class="apw-option-icon">🏢</span>
                        <span class="apw-option-text">Декілька апартаментів</span>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 2: Platforms ═══ -->
            <div class="apw-step apw-step-layout" id="step2">
                <h2 class="apw-step-title">Де ще зареєстровано ваше помешкання?</h2>
                <p class="apw-step-title-sub">Якщо помешкання вже є на інших платформах, ви можете прискорити реєстрацію, імпортуючи дані.</p>
                <div class="apw-card">
                    <div class="apw-check-item" onclick="toggleCheck(this)">
                        <div class="apw-check-box"></div>
                        <span class="apw-check-icon">✈️</span>
                        <span class="apw-check-text">Airbnb</span>
                    </div>
                    <div class="apw-check-item" onclick="toggleCheck(this)">
                        <div class="apw-check-box"></div>
                        <span class="apw-check-icon">⭐</span>
                        <span class="apw-check-text">TripAdvisor</span>
                    </div>
                    <div class="apw-check-item" onclick="toggleCheck(this)">
                        <div class="apw-check-box"></div>
                        <span class="apw-check-icon">🏡</span>
                        <span class="apw-check-text">Vrbo</span>
                    </div>
                    <div class="apw-check-item" onclick="toggleCheck(this)">
                        <div class="apw-check-box"></div>
                        <span class="apw-check-icon">🌐</span>
                        <span class="apw-check-text">Інший сайт</span>
                    </div>
                    <div class="apw-check-item" onclick="toggleCheck(this)">
                        <div class="apw-check-box"></div>
                        <span class="apw-check-text">Помешкання не зареєстроване на інших сайтах</span>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 3: Name  [S1·d1] ═══ -->
            <div class="apw-step apw-step-layout" id="step3">
                <div class="apw-stepper">
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot active"></div>
                            <div class="apw-dot"></div>
                            <div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Як називається ваше помешкання?</h2>
                <div class="apw-card">
                    <div class="apw-field">
                        <label class="apw-label" for="Name">Назва помешкання <span class="apw-required">*</span></label>
                        <input asp-for="Name" id="Name" class="apw-input" maxlength="150"
                               placeholder="Наприклад: Готель Атлас Делюкс"
                               oninput="syncCount(this,'nameCount',150)" />
                        <span class="apw-char-count"><span id="nameCount">@(Model.Name?.Length ?? 0)</span>/150</span>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 4: Address  [S1·d2] ═══ -->
            <div class="apw-step apw-step-layout" id="step4">
                <div class="apw-stepper">
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div>
                            <div class="apw-dot active"></div>
                            <div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Де розташоване ваше помешкання?</h2>
                <div class="apw-card">
                    <div class="apw-field">
                        <label class="apw-label">Вулиця <span class="apw-required">*</span></label>
                        <input asp-for="Street" class="apw-input" placeholder="Назва вулиці та номер будинку" />
                    </div>
                    <div class="apw-field">
                        <label class="apw-label">Номер апартаментів або поверх</label>
                        <input asp-for="ApartmentNumber" class="apw-input" placeholder="Наприклад: кв. 15, поверх 3" />
                    </div>
                    <div class="apw-field">
                        <label class="apw-label">Країна / регіон</label>
                        <input name="Country" class="apw-input" placeholder="Україна" />
                    </div>
                    <div class="apw-row">
                        <div class="apw-field">
                            <label class="apw-label">Місто <span class="apw-required">*</span></label>
                            <select asp-for="CityId" asp-items="Model.CityOptions" class="apw-select"></select>
                        </div>
                        <div class="apw-field apw-field--short">
                            <label class="apw-label">Буд. №</label>
                            <input asp-for="HouseNumber" class="apw-input" placeholder="№" />
                        </div>
                    </div>
                    <div class="apw-info-box">
                        <span class="apw-info-box-icon">💡</span>
                        <span>Точна адреса буде показана гостям лише після підтвердження бронювання. До цього відображатиметься лише приблизне розташування.</span>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 5: Channel Manager  [S1·d3] ═══ -->
            <div class="apw-step apw-step-layout" id="step5">
                <div class="apw-stepper">
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div>
                            <div class="apw-dot"></div>
                            <div class="apw-dot active"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Підключіться до менеджера каналів</h2>
                <div class="apw-card">
                    <p class="apw-card-note">
                        Менеджер каналів — це сервіс, який дозволяє керувати цінами та доступністю помешкання
                        на різних платформах (Booking.com та ін.). Якщо ви вже використовуєте менеджер каналів,
                        оберіть «Так», щоб підключити його до цього об'єкта.
                    </p>
                    <div class="apw-card-divider"></div>
                    <p class="apw-card-title">Хочете підключити цей об'єкт до свого менеджера каналів?</p>
                    <div class="apw-radio-group" id="channelGrp">
                        <div class="apw-radio-item selected" onclick="pickRadio(this,'channelGrp')">
                            <div class="apw-radio-circle"><div class="apw-radio-dot"></div></div>
                            <span>Так</span>
                            <input type="radio" name="ChannelManager" value="true" checked style="display:none" />
                        </div>
                        <div class="apw-radio-item" onclick="pickRadio(this,'channelGrp')">
                            <div class="apw-radio-circle"><div class="apw-radio-dot"></div></div>
                            <span>Ні</span>
                            <input type="radio" name="ChannelManager" value="false" style="display:none" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 6: Accommodation Info  [S2·d1] ═══ -->
            <div class="apw-step apw-step-layout" id="step6">
                <div class="apw-stepper">
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot active"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Інформація про помешкання</h2>

                <!-- Beds -->
                <div class="apw-card">
                    <p class="apw-section-hdr">Де гості можуть переночувати?</p>
                    @foreach (var bed in new[]{
                        ("🛏️","Односпальне","90–140 см","BedSingle"),
                        ("🛏️","Двоспальне","141–210 см","BedDouble"),
                        ("🛏️","Широке двоспальне (king size)","181–215 см","BedKing"),
                        ("🛏️","Особливе широке двоспальне (super king)","181+ см","BedSuperKing"),
                        ("🛋️","Декоративне ліжко","","BedDecor"),
                        ("🛋️","Диван-ліжко","","BedSofa"),
                        ("🛏️","Футон","","BedFuton")
                    })
                    {
                        <div class="apw-counter-row">
                            <div class="apw-counter-icon">@bed.Item1</div>
                            <div class="apw-counter-info">
                                <div class="apw-counter-label">@bed.Item2</div>
                                @if (!string.IsNullOrEmpty(bed.Item3))
                                {
                                    <div class="apw-counter-sub">@bed.Item3</div>
                                }
                            </div>
                            <div class="apw-counter">
                                <button type="button" class="apw-cnt-btn" onclick="cntChange(this,-1)">−</button>
                                <span class="apw-cnt-val">0</span>
                                <button type="button" class="apw-cnt-btn" onclick="cntChange(this,1)">+</button>
                                <input type="hidden" name="@bed.Item4" value="0" />
                            </div>
                        </div>
                    }
                </div>

                <!-- Guests & Bathrooms -->
                <div class="apw-card">
                    <div class="apw-counter-row">
                        <div class="apw-counter-info">
                            <div class="apw-counter-label">Скільки гостей може зупинитись?</div>
                            <div class="apw-counter-sub">Без урахування немовлят (0–2 роки)</div>
                        </div>
                        <div class="apw-counter">
                            <button type="button" class="apw-cnt-btn" onclick="cntChange(this,-1)">−</button>
                            <span class="apw-cnt-val">0</span>
                            <button type="button" class="apw-cnt-btn" onclick="cntChange(this,1)">+</button>
                            <input type="hidden" name="MaxGuests" value="0" />
                        </div>
                    </div>
                    <div class="apw-card-divider"></div>
                    <div class="apw-counter-row">
                        <div class="apw-counter-info">
                            <div class="apw-counter-label">Скільки ванних кімнат?</div>
                        </div>
                        <div class="apw-counter">
                            <button type="button" class="apw-cnt-btn" onclick="cntChange(this,-1)">−</button>
                            <span class="apw-cnt-val">0</span>
                            <button type="button" class="apw-cnt-btn" onclick="cntChange(this,1)">+</button>
                            <input type="hidden" name="Bathrooms" value="0" />
                        </div>
                    </div>
                </div>

                <!-- Children + Category -->
                <div class="apw-card">
                    <div class="apw-yn-row">
                        <div class="apw-yn-question">Чи дозволено розміщення з дітьми?</div>
                        <div class="apw-yn-group">
                            <button type="button" class="apw-yn-btn" onclick="ynPick(this)">Так</button>
                            <button type="button" class="apw-yn-btn active" onclick="ynPick(this)">Ні</button>
                            <input type="hidden" name="ChildrenAllowed" value="false" />
                        </div>
                    </div>
                    <div class="apw-yn-row">
                        <div>
                            <div class="apw-yn-question">Ви пропонуєте дитячі ліжечка?</div>
                            <div class="apw-yn-sub">Зазвичай надається до 3 ліжечок безкоштовно</div>
                        </div>
                        <div class="apw-yn-group">
                            <button type="button" class="apw-yn-btn" onclick="ynPick(this)">Так</button>
                            <button type="button" class="apw-yn-btn active" onclick="ynPick(this)">Ні</button>
                            <input type="hidden" name="CribsAvailable" value="false" />
                        </div>
                    </div>
                    <div class="apw-card-divider"></div>
                    <div class="apw-field">
                        <label class="apw-label" for="CategoryId">Категорія помешкання <span class="apw-required">*</span></label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="apw-select" id="CategoryId"></select>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 7: Amenities  [S2·d2] ═══ -->
            <div class="apw-step apw-step-layout" id="step7">
                <div class="apw-stepper">
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot active"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Чим можуть скористатися гості?</h2>

                @if (Model.AmenityOptions.Any())
                {
                    <div class="apw-amen-group-card">
                        <div class="apw-amen-group-title">Зручності</div>
                        @foreach (var a in Model.AmenityOptions)
                        {
                            <label class="apw-amenity-row">
                                <input type="checkbox" name="SelectedAmenityIds" value="@a.Value"
                                       @(Model.SelectedAmenityIds.Contains(long.Parse(a.Value)) ? "checked" : "") />
                                <div class="apw-am-check"></div>
                                <span>@a.Text</span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    @foreach (var grp in new[]{
                        ("Тип розміщення",     new[]{"Кондиціонер","Опалення","Wi-Fi","Станція для заряджання e-авто"}),
                        ("Готування та прибирання", new[]{"Кухня","Міні кухня","Пральна машина"}),
                        ("Розваги",            new[]{"Телевізор (потокове відео)","Більярд","Гідромасажна ванна","Сауна"}),
                        ("Зручності та краєвид",new[]{"Балкон","Вид на сад","Тераса","Вид"})
                    })
                    {
                        <div class="apw-amen-group-card">
                            <div class="apw-amen-group-title">@grp.Item1</div>
                            @foreach (var name in grp.Item2)
                            {
                                <label class="apw-amenity-row">
                                    <input type="checkbox" name="SelectedAmenityIds" value="0" />
                                    <div class="apw-am-check"></div>
                                    <span>@name</span>
                                </label>
                            }
                        </div>
                    }
                }
            </div>

            <!-- ═══ STEP 8: Services  [S2·d3] ═══ -->
            <div class="apw-step apw-step-layout" id="step8">
                <div class="apw-stepper">
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot active"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Послуги у вашому помешканні</h2>

                <!-- Breakfast -->
                <div class="apw-card">
                    <p class="apw-section-hdr">Сніданок</p>
                    <div class="apw-yn-row">
                        <div class="apw-yn-question">Чи подаєте ви сніданок гостям?</div>
                        <div class="apw-yn-group">
                            <button type="button" class="apw-yn-btn" onclick="ynPick(this)">Так</button>
                            <button type="button" class="apw-yn-btn active" onclick="ynPick(this)">Ні</button>
                            <input type="hidden" name="BreakfastServed" value="false" />
                        </div>
                    </div>
                    <div class="apw-yn-row">
                        <div class="apw-yn-question">Сніданок включений у вартість проживання?</div>
                        <div class="apw-yn-group">
                            <button type="button" class="apw-yn-btn" onclick="ynPick(this)">Так</button>
                            <button type="button" class="apw-yn-btn active" onclick="ynPick(this)">Ні</button>
                            <input type="hidden" name="BreakfastIncluded" value="false" />
                        </div>
                    </div>
                    <div class="apw-card-divider"></div>
                    <p class="apw-card-title">Який тип сніданку ви пропонуєте?</p>
                    @foreach (var bt in new[]{"Страви за меню","Американський","Азіатський","Сніданок із собою","Шведський стіл","Континентальний","Традиційний англійський / ірландський","Безглютеновий","Халяльний","Гіпоалергенний","Кошерний","Веганський","Вегетаріанський"})
                    {
                        <label class="apw-amenity-row">
                            <input type="checkbox" name="BreakfastType" value="@bt" />
                            <div class="apw-am-check"></div>
                            <span>@bt</span>
                        </label>
                    }
                </div>

                <!-- Parking -->
                <div class="apw-card">
                    <p class="apw-section-hdr">Парковка</p>
                    <p class="apw-card-title">Чи є парковка для гостей?</p>
                    @foreach (var opt in new[]{"Так, безплатно","Так, за додаткову оплату","Ні"})
                    {
                        <label class="apw-amenity-row">
                            <input type="radio" name="ParkingAvailable" value="@opt" />
                            <div class="apw-am-check"></div><span>@opt</span>
                        </label>
                    }
                    <div class="apw-card-divider"></div>
                    <p class="apw-card-title">Чи необхідно бронювати паркомісце?</p>
                    @foreach (var opt in new[]{"Бронювання необхідно","Бронювання не потрібно"})
                    {
                        <label class="apw-amenity-row">
                            <input type="radio" name="ParkingReservation" value="@opt" />
                            <div class="apw-am-check"></div><span>@opt</span>
                        </label>
                    }
                    <div class="apw-card-divider"></div>
                    <p class="apw-card-title">Де розташована парковка?</p>
                    @foreach (var opt in new[]{"На території","Поза межами помешкання"})
                    {
                        <label class="apw-amenity-row">
                            <input type="radio" name="ParkingLocation" value="@opt" />
                            <div class="apw-am-check"></div><span>@opt</span>
                        </label>
                    }
                    <div class="apw-card-divider"></div>
                    <p class="apw-card-title">Який тип парковки?</p>
                    @foreach (var opt in new[]{"Приватна","Громадська"})
                    {
                        <label class="apw-amenity-row">
                            <input type="radio" name="ParkingType" value="@opt" />
                            <div class="apw-am-check"></div><span>@opt</span>
                        </label>
                    }
                </div>
            </div>

            <!-- ═══ STEP 9: Languages  [S2·d4] ═══ -->
            <div class="apw-step apw-step-layout" id="step9">
                <div class="apw-stepper">
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot active"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Якими мовами говорите ви або ваш персонал?</h2>
                <div class="apw-card">
                    <p class="apw-card-title">Вибрати мови</p>
                    <div class="apw-lang-list">
                        @foreach (var lang in new[]{"Українська","Англійська","Польська","Чеська"})
                        {
                            <label class="apw-lang-item" onclick="toggleLang(this)">
                                <input type="checkbox" name="Languages" value="@lang" />
                                <div class="apw-lang-check"></div>
                                <span>@lang</span>
                            </label>
                        }
                    </div>
                    <div class="apw-card-divider"></div>
                    <div class="apw-field">
                        <label class="apw-label">Додати інші мови</label>
                        <select name="ExtraLanguage" class="apw-select">
                            <option value="">Вибрати мову</option>
                            @foreach (var lang in new[]{"Французька","Німецька","Іспанська","Італійська","Португальська","Румунська","Угорська","Словацька","Болгарська","Хорватська","Нідерландська","Турецька","Арабська","Китайська","Японська"})
                            {
                                <option value="@lang">@lang</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 10: House Rules + Check-in/out  [S2·d5] ═══ -->
            <div class="apw-step apw-step-layout" id="step10">
                <div class="apw-stepper">
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot active"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Порядок проживання</h2>

                <!-- Smoking / Parties -->
                <div class="apw-card">
                    <div class="apw-yn-row">
                        <div class="apw-yn-question">Курити дозволено</div>
                        <div class="apw-yn-group">
                            <button type="button" class="apw-yn-btn" onclick="ynPick(this)">Так</button>
                            <button type="button" class="apw-yn-btn active" onclick="ynPick(this)">Ні</button>
                            <input type="hidden" name="SmokingAllowed" value="false" />
                        </div>
                    </div>
                    <div class="apw-yn-row">
                        <div class="apw-yn-question">Проводити вечірки/заходи дозволено</div>
                        <div class="apw-yn-group">
                            <button type="button" class="apw-yn-btn" onclick="ynPick(this)">Так</button>
                            <button type="button" class="apw-yn-btn active" onclick="ynPick(this)">Ні</button>
                            <input type="hidden" name="PartiesAllowed" value="false" />
                        </div>
                    </div>
                </div>

                <!-- Pets -->
                <div class="apw-card">
                    <p class="apw-section-hdr">Чи дозволено розміщення з домашніми тваринами?</p>
                    <div class="apw-radio-group" id="petsGrp">
                        <div class="apw-radio-item selected" onclick="pickRadio(this,'petsGrp')">
                            <div class="apw-radio-circle"><div class="apw-radio-dot"></div></div>
                            <span>Так</span>
                            <input type="radio" name="PetsAllowed" value="yes" checked style="display:none" />
                        </div>
                        <div class="apw-radio-item" onclick="pickRadio(this,'petsGrp')">
                            <div class="apw-radio-circle"><div class="apw-radio-dot"></div></div>
                            <span>За запитом</span>
                            <input type="radio" name="PetsAllowed" value="request" style="display:none" />
                        </div>
                        <div class="apw-radio-item" onclick="pickRadio(this,'petsGrp')">
                            <div class="apw-radio-circle"><div class="apw-radio-dot"></div></div>
                            <span>Ні</span>
                            <input type="radio" name="PetsAllowed" value="no" style="display:none" />
                        </div>
                    </div>
                    <div class="apw-card-divider"></div>
                    <p class="apw-section-hdr">Чи стягується додаткова плата за тварин?</p>
                    <label class="apw-amenity-row">
                        <input type="radio" name="PetsFee" value="none" checked />
                        <div class="apw-am-check"></div>
                        <span>Плата не стягується</span>
                    </label>
                    <label class="apw-amenity-row">
                        <input type="radio" name="PetsFee" value="extra" />
                        <div class="apw-am-check"></div>
                        <span>Може стягуватись додаткова плата</span>
                    </label>
                </div>

                <!-- Check-in / Check-out -->
                <div class="apw-card">
                    <div class="apw-checkinout-grid">
                        <div>
                            <div class="apw-checkinout-title">Заїзд</div>
                            <div class="apw-checkinout-row">
                                <span class="apw-checkinout-lbl">Від</span>
                                <select name="ArrivalFrom" class="apw-time-sel">
                                    @for (int h = 0; h < 24; h++)
                                    {
                                        var v = $"{h:D2}:00";
                                        <option value="@v" selected="@(Model.ArrivalFrom == v ? "selected" : null)">@v</option>
                                    }
                                </select>
                                <span class="apw-checkinout-lbl">До</span>
                                <select name="ArrivalTo" class="apw-time-sel">
                                    @for (int h = 0; h < 24; h++)
                                    {
                                        var v = $"{h:D2}:00";
                                        <option value="@v" selected="@(Model.ArrivalTo == v ? "selected" : null)">@v</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div>
                            <div class="apw-checkinout-title">Виїзд</div>
                            <div class="apw-checkinout-row">
                                <span class="apw-checkinout-lbl">Від</span>
                                <select name="DepartureFrom" class="apw-time-sel">
                                    @for (int h = 0; h < 24; h++)
                                    {
                                        var v = $"{h:D2}:00";
                                        <option value="@v" selected="@(Model.DepartureFrom == v ? "selected" : null)">@v</option>
                                    }
                                </select>
                                <span class="apw-checkinout-lbl">До</span>
                                <select name="DepartureTo" class="apw-time-sel">
                                    @for (int h = 0; h < 24; h++)
                                    {
                                        var v = $"{h:D2}:00";
                                        <option value="@v" selected="@(Model.DepartureTo == v ? "selected" : null)">@v</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ STEP 11: Host Profile  [S2·d6] ═══ -->
            <div class="apw-step apw-step-layout" id="step11">
                <div class="apw-stepper">
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot active"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Профіль господаря</h2>
                <div class="apw-card">
                    <p class="apw-card-note">
                        Розкажіть гостям про себе, житло та район. Ця інформація буде на сторінці господаря.
                    </p>
                    <div class="apw-field">
                        <label class="apw-label">
                            Про помешкання <span class="apw-required">*</span>
                            <span style="float:right;font-weight:400;color:#ccc;font-size:11px">
                                <span id="descCount">@(Model.Description?.Length ?? 0)</span>/1500
                            </span>
                        </label>
                        <textarea asp-for="Description" id="Description" class="apw-textarea" rows="3"
                                  maxlength="1500"
                                  placeholder="Що робить ваше помешкання особливим?"
                                  oninput="syncCount(this,'descCount',1500)"></textarea>
                    </div>
                    <div class="apw-field">
                        <label class="apw-label">
                            Ім'я господаря
                            <span style="float:right;font-weight:400;color:#ccc;font-size:11px">
                                <span id="hostNameCnt">0</span>/250
                            </span>
                        </label>
                        <input name="HostDisplayName" class="apw-input" maxlength="250"
                               placeholder="Як вас звати?"
                               oninput="syncCount(this,'hostNameCnt',250)" />
                    </div>
                    <div class="apw-field">
                        <label class="apw-label">
                            Про господаря
                            <span style="float:right;font-weight:400;color:#ccc;font-size:11px">
                                <span id="aboutHostCnt">0</span>/1500
                            </span>
                        </label>
                        <textarea name="AboutHost" class="apw-textarea" rows="3" maxlength="1500"
                                  placeholder="Розкажіть гостям про себе..."
                                  oninput="syncCount(this,'aboutHostCnt',1500)"></textarea>
                    </div>
                    <div class="apw-field">
                        <label class="apw-label">
                            Про район
                            <span style="float:right;font-weight:400;color:#ccc;font-size:11px">
                                <span id="aboutAreaCnt">0</span>/1500
                            </span>
                        </label>
                        <textarea name="AboutArea" class="apw-textarea" rows="3" maxlength="1500"
                                  placeholder="Що варто знати про ваш район?"
                                  oninput="syncCount(this,'aboutAreaCnt',1500)"></textarea>
                    </div>
                    <label class="apw-amenity-row">
                        <input type="checkbox" name="InfoLater" value="true" />
                        <div class="apw-am-check"></div>
                        <span>Я надам цю інформацію пізніше</span>
                    </label>
                </div>
            </div>

            <!-- ═══ STEP 12: Photos  [S3·d1] ═══ -->
            <div class="apw-step apw-step-layout" id="step12">
                <div class="apw-stepper">
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">1</span>
                        <span class="apw-step-label-text">Загальна інформація</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item">
                        <span class="apw-step-num-label">2</span>
                        <span class="apw-step-label-text">Створення сторінки помешкання</span>
                        <div class="apw-step-dots">
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                            <div class="apw-dot"></div><div class="apw-dot"></div>
                        </div>
                    </div>
                    <div class="apw-step-item active">
                        <span class="apw-step-num-label">3</span>
                        <span class="apw-step-label-text">Фотографії</span>
                        <div class="apw-step-dots"><div class="apw-dot active"></div></div>
                    </div>
                </div>
                <h2 class="apw-step-title">Як виглядає ваше помешкання?</h2>
                <div class="apw-card">
                    <p class="apw-card-note">
                        Завантажте принаймні 5 фото вашого помешкання. Чим більше фотографій — тим більше бронювань.
                    </p>

                    <p class="apw-card-title">Основна фотографія</p>
                    <div class="apw-photo-zone" id="mainZone">
                        <input type="file" name="Photos" id="mainInput"
                               accept="image/jpeg,image/png,image/webp"
                               class="apw-photo-zone-input"
                               onchange="onMainChange(this)" />
                        <div id="mainEmpty">
                            <p class="apw-photo-zone-text">Треба перетягнути фотографії сюди або</p>
                            <button type="button" class="apw-photo-upload-btn"
                                    onclick="document.getElementById('mainInput').click();event.stopPropagation()">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                Завантажити фотографії
                            </button>
                            <p class="apw-photo-zone-sub">Допустимі формати: jpg/png; до 4 МБ</p>
                        </div>
                        <div id="mainPreview" class="apw-photo-preview" style="display:none"></div>
                    </div>

                    <p class="apw-card-title">Додаткові фотографії</p>
                    <div class="apw-photo-zone" id="extraZone">
                        <input type="file" name="Photos" id="extraInput"
                               accept="image/jpeg,image/png,image/webp"
                               multiple class="apw-photo-zone-input"
                               onchange="onExtraChange(this)" />
                        <div id="extraEmpty">
                            <p class="apw-photo-zone-text">Треба перетягнути фотографії сюди або</p>
                            <button type="button" class="apw-photo-upload-btn"
                                    onclick="document.getElementById('extraInput').click();event.stopPropagation()">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                Завантажити фотографії
                            </button>
                            <p class="apw-photo-zone-sub">Допустимі формати: jpg/png; до 4 МБ</p>
                        </div>
                        <div id="extraPreview" class="apw-photo-preview" style="display:none"></div>
                    </div>

                    @if (hasError)
                    {
                        <div class="apw-error-msg">@Model.SaveError</div>
                    }
                    @if (TempData["PropertyAdded"] != null)
                    {
                        <div class="apw-success-msg">Помешкання успішно додано та надіслано на модерацію!</div>
                    }
                </div>
            </div>

        </div><!-- /apw-content -->

        <!-- ════════════════════════════════════════
             FIXED BOTTOM NAVIGATION BAR
             (hidden by default, shown via JS → .visible)
             ════════════════════════════════════════ -->
        <div class="apw-bottom-bar" id="apwBar">
            <button type="button" class="apw-back-btn" onclick="goBack()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </button>
            <button type="button" class="apw-continue-btn" id="apwContinue" onclick="goNext()">
                Продовжити
            </button>
        </div>

    </form>
</div><!-- /apw-page -->

<!-- ════════════════════════════════════════
     JAVASCRIPT — Multi-step logic
     ════════════════════════════════════════ -->
<script>
(function () {
    'use strict';

    var TOTAL = 13;  // steps 0..12
    var cur   = 0;

    /* ── Core step switch ── */
    function showStep(n) {
        // Hide all steps
        document.querySelectorAll('.apw-step').forEach(function (el) {
            el.classList.remove('active');
        });
        // Show requested step
        var target = document.getElementById('step' + n);
        if (target) target.classList.add('active');
        cur = n;

        var bar      = document.getElementById('apwBar');
        var btn      = document.getElementById('apwContinue');
        var regLabel = document.getElementById('navRegLabel');

        if (n === 0) {
            // Step 0: hide bottom bar, show "register" label in navbar
            bar.classList.remove('visible');
            if (regLabel) regLabel.style.display = '';
        } else {
            // Steps 1-12: show bottom bar, hide navbar label
            bar.classList.add('visible');
            if (regLabel) regLabel.style.display = 'none';
            var isLast = (n === TOTAL - 1);
            btn.textContent = isLast ? 'Додати помешкання' : 'Продовжити';
            btn.onclick     = isLast ? doSubmit : goNext;
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* ── Navigation ── */
    function goNext() { if (validate(cur)) showStep(cur + 1); }
    function goBack() { if (cur > 0) showStep(cur - 1); }
    function doSubmit() { if (validate(cur)) document.getElementById('apwForm').submit(); }

    /* Expose to onclick attributes */
    window.goNext  = goNext;
    window.goBack  = goBack;

    /* ── Validation ── */
    function validate(n) {
        if (n === 3) {
            var name = document.getElementById('Name').value.trim();
            if (!name) { flash('Введіть назву помешкання.'); return false; }
        }
        if (n === 4) {
            var city = document.querySelector('select[name="CityId"]');
            if (!city || !city.value || city.value === '0') { flash('Оберіть місто.'); return false; }
            var street = document.querySelector('input[name="Street"]');
            if (!street || !street.value.trim()) { flash('Введіть вулицю.'); return false; }
        }
        if (n === 6) {
            var cat = document.getElementById('CategoryId');
            if (!cat || !cat.value || cat.value === '0') { flash('Оберіть категорію помешкання.'); return false; }
        }
        if (n === 11) {
            var desc = document.getElementById('Description').value.trim();
            if (!desc) { flash('Додайте опис помешкання.'); return false; }
        }
        if (n === 12) {
            var main = document.getElementById('mainInput');
            if (!main || main.files.length === 0) { flash('Додайте головне фото помешкання.'); return false; }
        }
        return true;
    }

    /* ── Inline flash message (replaces browser alert) ── */
    function flash(msg) {
        var old = document.getElementById('apwFlash');
        if (old) old.remove();
        var el = document.createElement('div');
        el.id = 'apwFlash';
        el.className = 'apw-inline-alert';
        el.textContent = msg;
        document.body.appendChild(el);
        setTimeout(function () { el.style.opacity = '0'; el.style.transition = 'opacity .3s'; }, 2500);
        setTimeout(function () { el.remove(); }, 2900);
    }

    /* ── Step 0: pick type ── */
    window.pickType = function (card) {
        document.querySelectorAll('.apw-type-card').forEach(function (c) { c.classList.remove('selected'); });
        card.classList.add('selected');
        setTimeout(function () { showStep(1); }, 180);
    };

    /* ── Count step (radio cards) ── */
    window.pickOption = function (activeId, otherId) {
        document.getElementById(activeId).classList.add('selected');
        document.getElementById(otherId).classList.remove('selected');
    };

    /* ── Generic radio group ── */
    window.pickRadio = function (item) {
        var group = item.closest('.apw-radio-group');
        if (!group) return;
        group.querySelectorAll('.apw-radio-item').forEach(function (i) { i.classList.remove('selected'); });
        item.classList.add('selected');
        var radio = item.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
    };

    /* ── Platform checkbox ── */
    window.toggleCheck = function (el) { el.classList.toggle('selected'); };

    /* ── Language checkbox ── */
    window.toggleLang = function (el) {
        el.classList.toggle('checked');
        var cb = el.querySelector('input[type="checkbox"]');
        if (cb) cb.checked = el.classList.contains('checked');
    };

    /* ── Yes/No buttons ── */
    window.ynPick = function (btn) {
        var group  = btn.closest('.apw-yn-group');
        var hidden = group ? group.querySelector('input[type="hidden"]') : null;
        if (group) group.querySelectorAll('.apw-yn-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        if (hidden) hidden.value = (btn.textContent.trim() === 'Так') ? 'true' : 'false';
    };

    /* ── Counter +/− ── */
    window.cntChange = function (btn, delta) {
        var counter = btn.closest('.apw-counter');
        var valEl   = counter.querySelector('.apw-cnt-val');
        var hidden  = counter.querySelector('input[type="hidden"]');
        var val     = Math.max(0, parseInt(valEl.textContent) + delta);
        valEl.textContent = val;
        if (hidden) hidden.value = val;
    };

    /* ── Character counter ── */
    window.syncCount = function (el, spanId, max) {
        var sp = document.getElementById(spanId);
        if (sp) sp.textContent = el.value.length;
    };

    /* ── Main photo preview ── */
    function onMainChange(input) {
        if (!input.files.length) return;
        var preview = document.getElementById('mainPreview');
        var empty   = document.getElementById('mainEmpty');
        preview.innerHTML = '';
        preview.style.display = 'flex';
        empty.style.display   = 'none';
        var reader = new FileReader();
        reader.onload = function (e) {
            var wrap  = document.createElement('div');
            wrap.className = 'apw-photo-thumb apw-photo-thumb--main';
            var badge = document.createElement('span');
            badge.className   = 'apw-photo-main-badge';
            badge.textContent = 'Головне';
            var img = document.createElement('img');
            img.src = e.target.result;
            wrap.appendChild(badge);
            wrap.appendChild(img);
            preview.appendChild(wrap);
        };
        reader.readAsDataURL(input.files[0]);
    }
    window.onMainChange = onMainChange;

    /* ── Extra photos preview ── */
    function onExtraChange(input) {
        if (!input.files.length) return;
        var preview = document.getElementById('extraPreview');
        var empty   = document.getElementById('extraEmpty');
        preview.innerHTML = '';
        preview.style.display = 'flex';
        empty.style.display   = 'none';
        Array.from(input.files).slice(0, 9).forEach(function (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var wrap = document.createElement('div');
                wrap.className = 'apw-photo-thumb';
                var img = document.createElement('img');
                img.src = e.target.result;
                wrap.appendChild(img);
                preview.appendChild(wrap);
            };
            reader.readAsDataURL(file);
        });
    }
    window.onExtraChange = onExtraChange;

    /* ── Drag & drop ── */
    ['mainZone', 'extraZone'].forEach(function (zid) {
        var zone = document.getElementById(zid);
        if (!zone) return;
        zone.addEventListener('dragover',  function (e) { e.preventDefault(); zone.classList.add('drag-over'); });
        zone.addEventListener('dragleave', function ()  { zone.classList.remove('drag-over'); });
        zone.addEventListener('drop',      function (e) {
            e.preventDefault();
            zone.classList.remove('drag-over');
            var inp = zone.querySelector('input[type="file"]');
            var dt  = new DataTransfer();
            Array.from(e.dataTransfer.files).forEach(function (f) { dt.items.add(f); });
            inp.files = dt.files;
            inp.dispatchEvent(new Event('change'));
        });
    });

    /* ── Amenity / parking radio row click ── */
    document.querySelectorAll('.apw-amenity-row').forEach(function (row) {
        var cb = row.querySelector('input[type="checkbox"]');
        var rb = row.querySelector('input[type="radio"]');
        if (cb && cb.checked) row.classList.add('checked');
        row.addEventListener('click', function (e) {
            if (e.target.tagName === 'INPUT') return;
            if (cb) {
                cb.checked = !cb.checked;
                row.classList.toggle('checked', cb.checked);
            } else if (rb) {
                // deselect siblings
                var form = row.closest('.apw-card') || document.body;
                form.querySelectorAll('.apw-amenity-row.radio-sel').forEach(function (r) {
                    if (r.querySelector('input[name="' + rb.name + '"]')) r.classList.remove('radio-sel');
                });
                rb.checked = true;
                row.classList.add('radio-sel');
            }
        });
    });

    /* ── Init: show step 0 on load (or step 12 if backend error) ── */
    showStep(@(hasError ? 12 : 0));

}());
</script>
</body>
</html>

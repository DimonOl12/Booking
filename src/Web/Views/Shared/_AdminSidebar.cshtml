@model string
@{
    var active = Model ?? "";
}
<aside class="adm-sidebar">
    <div class="adm-sidebar-logo">
        <div class="adm-sidebar-logo-icon">R</div>
        <div>
            <div class="adm-sidebar-logo-text">Reservio</div>
            <div class="adm-sidebar-logo-sub">Admin Panel</div>
        </div>
    </div>

    <nav class="adm-nav">
        <div class="adm-nav-label">Головне</div>
        <a href="/Admin/Dashboard" class="adm-nav-item @(active == "Dashboard" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Дашборд
        </a>

        <div class="adm-nav-label">Користувачі</div>
        <a href="/Admin/Users" class="adm-nav-item @(active == "Users" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            Клієнти
        </a>
        <a href="/Admin/Realtors" class="adm-nav-item @(active == "Realtors" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Ріелтори
        </a>

        <div class="adm-nav-label">Каталог</div>
        <a href="/Admin/Hotels" class="adm-nav-item @(active == "Hotels" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            Готелі
        </a>

        <div class="adm-nav-label">Сайт</div>
        <a href="/" class="adm-nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            На сайт
        </a>
    </nav>

    <div class="adm-sidebar-bottom">
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="adm-sidebar-exit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Вийти
            </button>
        </form>
    </div>
</aside>
